# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the filled file.
#   cp .env.example .env
#
# The server does NOT read .env by itself. Either export the vars via systemd
# (EnvironmentFile=) or source them in your shell:
#   set -a && . ./.env && set +a && node server.js
# ---------------------------------------------------------------------------

# ---- listen ----
PORT=3401
HOST=127.0.0.1

# ---- upstream (the OpenAI/Anthropic-compatible provider you resell) ----
# Base origin only, no trailing /v1.
UPSTREAM_BASE=https://upstream.example

# Your provider key. Requests arriving with a key listed in CLIENT_KEYS are
# rewritten to use this one, so the real key never leaves the server.
UPSTREAM_KEY=

# ---- client keys ----
# Comma-separated keys you hand out to customers. Each is swapped for
# UPSTREAM_KEY on the way out.
# Leave empty and set PASSTHROUGH=1 if customers bring their own upstream keys.
CLIENT_KEYS=

# When 1, a key that is NOT in CLIENT_KEYS is forwarded upstream unchanged.
# This is what lets provider customers point their own key at your domain.
PASSTHROUGH=1

# ---- public identity ----
# Optional. When empty, the portal derives the public origin from Host and the
# reverse proxy's X-Forwarded-Host / X-Forwarded-Proto headers.
PUBLIC_ORIGIN=

# Optional full API Base URL override. Use this when the public API lives under
# a non-standard path or on another host. It takes precedence over PUBLIC_ORIGIN.
PUBLIC_BASE_URL=

# Optional external status page. When empty, the button opens /status on the
# same domain, so it works without a separate status.* DNS record.
STATUS_URL=

# Trust standard reverse-proxy headers only from a loopback peer. Keep nginx,
# Traefik, or Caddy on the same host and make it overwrite/append
# X-Forwarded-For. Direct remote peers cannot supply a trusted client address.
TRUST_PROXY=1

# Brand text rendered on login, dashboard and status pages.
PORTAL_NAME=API PORTAL

# ---- limits ----
MAX_BODY_BYTES=104857600
PORTAL_LOGIN_MAX_ATTEMPTS=10
PORTAL_LOGIN_WINDOW_MS=60000
PORTAL_LOGIN_BUCKETS_MAX=5000
PORTAL_LOGIN_BODY_BYTES=16384
PORTAL_SESSION_TTL_MS=43200000
PORTAL_SESSION_MAX=5000

# ---- pricing ----
# Legacy scale for token-package and compatibility views. Ordinary monetary
# keys use exact USD fields from New API and are not affected by this value.
CREDITS_PER_USD=10000

# ---- provider telemetry (optional, powers the public status page) ----
# Preferred for current New API releases: create a management Access Token in
# Profile -> Security. This is not an sk-* model API key.
UPSTREAM_DASHBOARD_TOKEN=

# Legacy New API fallback: old releases authenticated dashboard requests with
# a browser session cookie plus a numeric New-Api-User header.
UPSTREAM_SESSION=
UPSTREAM_SESSION_USER=

# ---- optional ----
# Static files directory. Defaults to ./public next to server.js.
# PUBLIC_DIR=/opt/api-portal/public

# JSON file with an announcement banner shown at the top of the dashboard.
# NEWS_FILE=/etc/api-portal/news.json
